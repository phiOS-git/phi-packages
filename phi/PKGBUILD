# Maintainer: flavio <flaviofm99@gmail.com>
#
# pkgver always names a real tag in the phi repository; the version history
# lives in that repo's tags, not here. pkgrel increments for a packaging-only
# rebuild with no source change.

pkgname=phi
pkgver=0.22.0
pkgrel=1
pkgdesc="phiOS unified CLI"
arch=('x86_64')
url="https://github.com/phiOS-git/phi"
license=('custom')
makedepends=('go' 'git')
source=("git+https://github.com/phiOS-git/phi.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
	cd "$srcdir/phi"
	export CGO_ENABLED=0
	# internal/build.Version is "dev" in a local checkout; this is the only
	# place that ever overwrites it.
	go build -trimpath -ldflags "-s -w -X phi/internal/build.Version=${pkgver}" -o phi ./cmd/phi
}

check() {
	cd "$srcdir/phi"
	go vet ./...
}

package() {
	cd "$srcdir/phi"
	install -Dm755 phi "$pkgdir/usr/bin/phi"

	# Completions and the man page are generated by the freshly built binary
	# from its own Commands list, never checked into a repository. The .1 is
	# installed uncompressed; makepkg's tidy step gzips usr/share/man/*.
	./phi completion zsh > phi.zsh-completion
	install -Dm644 phi.zsh-completion "$pkgdir/usr/share/zsh/site-functions/_phi"

	./phi man > phi.1
	install -Dm644 phi.1 "$pkgdir/usr/share/man/man1/phi.1"
}
