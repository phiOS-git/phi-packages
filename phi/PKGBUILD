# Maintainer: flavio <flaviofm99@gmail.com>
pkgname=phi
pkgver=0.7.0
pkgrel=1
pkgdesc="phiOS unified CLI"
arch=('x86_64')
url="https://github.com/phiOS-git/phi"
license=('custom')
makedepends=('go' 'git')
source=("git+https://github.com/phiOS-git/phi.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
	cd "$srcdir/phi"
	export CGO_ENABLED=0
	# internal/build.Version is "dev" in a local checkout; this is the only
	# place that ever overwrites it (phi/CLAUDE.md, phi/internal/build/build.go).
	go build -trimpath -ldflags "-s -w -X phi/internal/build.Version=${pkgver}" -o phi ./cmd/phi
}

check() {
	cd "$srcdir/phi"
	go vet ./...
}

package() {
	cd "$srcdir/phi"
	install -Dm755 phi "$pkgdir/usr/bin/phi"

	# Completions and the man page are generated here, by the freshly built
	# binary itself, from its own Commands list (internal/view/view.go) —
	# never checked into any repository (S-15 DONE WHEN: "regenerated by
	# the build, not committed by hand"). The .1 file is installed
	# uncompressed; makepkg's own tidy step gzips usr/share/man/* by
	# default, unverified here since no real makepkg run was available off-
	# machine.
	./phi completion zsh > phi.zsh-completion
	install -Dm644 phi.zsh-completion "$pkgdir/usr/share/zsh/site-functions/_phi"

	./phi man > phi.1
	install -Dm644 phi.1 "$pkgdir/usr/share/man/man1/phi.1"
}
